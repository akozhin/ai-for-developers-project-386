# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Подключение к PostgreSQL (значения совпадают с docker-compose.yml; БД поднимает make up)
DATABASE_URL=postgresql+asyncpg://cal:cal@localhost:5432/cal
# БД для тестов backend (создаётся автоматически, данные очищаются после каждого теста)
TEST_DATABASE_URL=postgresql+asyncpg://cal:cal@localhost:5432/cal_test

# Рабочее расписание владельца: одно на все типы событий (время кратно 30 минутам)
OWNER_TIMEZONE=Europe/Moscow
WORK_DAYS=mon,tue,wed,thu,fri
WORK_START=10:00
WORK_END=18:00
# Минимум минут от «сейчас» до начала слота, 0 — без запаса
BOOKING_MIN_NOTICE_MINUTES=120
