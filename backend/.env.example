# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Подключение к PostgreSQL (значения совпадают с docker-compose.yml; БД поднимает make up)
DATABASE_URL=postgresql+asyncpg://cal:cal@localhost:5432/cal
# БД для тестов backend (создаётся автоматически, данные очищаются после каждого теста)
TEST_DATABASE_URL=postgresql+asyncpg://cal:cal@localhost:5432/cal_test

# Рабочее расписание владельца: одно на все типы событий (время кратно 30 минутам)
OWNER_TIMEZONE=Europe/Moscow
WORK_DAYS=mon,tue,wed,thu,fri
WORK_START=10:00
WORK_END=18:00
# Минимум минут от «сейчас» до начала слота, 0 — без запаса
BOOKING_MIN_NOTICE_MINUTES=120

# Профиль владельца для шапки главного экрана
OWNER_NAME=Alexandr Kozhin
# Адрес аватара; по умолчанию файл из публичных файлов frontend, пусто — показываются инициалы
OWNER_AVATAR_URL=/avatar.jpg

# Ключ AI-провайдера (OpenAI-совместимый API); пусто — вкладка «Подобрать с AI» скрыта
AI_API_KEY=
# Адрес OpenAI-совместимого API и модель (должна поддерживать вызов инструментов)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-haiku-4.5

# Docker-образ (ADR-004): порт, миграции и начальные данные при старте контейнера
# PORT=8000
# RUN_MIGRATIONS=true   # применить миграции перед стартом (ошибка останавливает контейнер)
# SEED_ON_START=true    # создать типы событий на 30 и 60 минут (повтор безопасен)
# Каталог собранного frontend (в образе подхватывается автоматически)
# FRONTEND_DIST=
