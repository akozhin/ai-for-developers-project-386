# Скопируйте в .env.local. Файлы .env* не коммитятся (кроме этого образца).
# Адрес backend; читается только на сервере Next.
API_URL=http://localhost:8000
# Пока нет настоящего backend, ответы подменяет MSW (только вне production).
# Внимание: при MOCK_API=true проксирование /api/v1 в Next зависает (MSW
# перехватывает rewrites) — для проверки /admin с реальным backend ставьте false.
MOCK_API=true
