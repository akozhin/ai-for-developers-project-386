{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "TypeSpec-контракт API «Запись на звонок»; из него генерируется openapi.yaml",
  "scripts": {
    "build": "tsp compile .",
    "format": "tsp format \"**/*.tsp\"",
    "format:check": "tsp format --check \"**/*.tsp\""
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0"
  }
}
